# ESP-IDF build outputs (never commit)
build/
**/build/

# Component Manager (recreated by idf.py build / update-dependencies)
**/managed_components/
managed_components/

# sdkconfig is per-project local state — use sdkconfig.defaults in git
/sdkconfig
/sdkconfig.old
**/sdkconfig
!**/sdkconfig.defaults
!**/sdkconfig.defaults.*

# Lock files: only inside example projects (not repo root)
/dependencies.lock

# Backups
*.bak

# CMake / tooling
**/CMakeCache.txt
**/compile_commands.json
**/.cmake/

# Python
__pycache__/
**/__pycache__/
*.py[cod]
.Python
venv/
.venv/
*.egg-info/
.eggs/

# Python / test / type-checker caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.tox/
.nox/
.hypothesis/
htmlcov/
.coverage
.coverage.*
*.cover
pip-wheel-metadata/

# Generic tool caches (esp. Language Server / IDEs)
.cache/
**/.cache/

# Node (if you add a docs/site toolchain locally)
node_modules/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~

# Logs & debug
*.log

# Local docs scaffold (not pushed to GitHub; see docs.iotmer.com / internal copies)
docs/

.envrc
.env

# Local packaging artifacts (ESP Component Manager / compote)
components/iotmer/dist/
components/iotmer_ble/dist/

# Local create-app / CI scratch (never commit generated firmware trees)
ci-scratch/

.vscode/
