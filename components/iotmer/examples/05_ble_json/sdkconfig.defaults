#
# Example defaults for BLE JSON provisioning over iotmer_ble (ESP-IDF v5+ / v6).
#

# Enable IOTMER BLE component
CONFIG_IOTMER_BLE=y

# GAP advertised name prefix (append short MAC-derived hex suffix)
CONFIG_IOTMER_BLE_GAP_NAME_PREFIX="MER-"

# Enable Bluetooth + NimBLE (adjust in menuconfig if your target differs)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_GATT_SERVER=y

# Optional: avoid flash size warning on common 4MB modules
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# This example pulls in HTTPS provisioning + device-auth to perform bind-claim,
# so the default 1MB app partition can be too small.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# TLS / HTTPS: use the built-in certificate bundle.
# Fixes errors like: "esp-x509-crt-bundle: No matching trusted root certificate found"
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# HTTPS bind-claim + BLE coexistence: TLS on app_main needs ≥ 8 KB stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# This example only performs bind-claim over HTTPS (no OTA).
CONFIG_IOTMER_AUTO_OTA=n
CONFIG_IOTMER_FIRMWARE_POLL=n

